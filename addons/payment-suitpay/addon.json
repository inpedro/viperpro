{
    "id": "payment.suitpay",
    "name": "SuitPay Payments",
    "version": "1.0.0",
    "description": "SuitPay PIX deposits and payouts (Brazil).",
    "author": "Viper Pro (legacy integration, refactored)",
    "category": "payments",
    "requires": {
        "platform": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Addons\\Payments\\SuitPay\\": "src/"
        }
    },
    "contributes": {
        "payment_gateways": {
            "suitpay": "Addons\\Payments\\SuitPay\\SuitPayGateway"
        }
    },
    "permissions": [
        "payments.suitpay.configure",
        "payments.suitpay.payout"
    ],
    "config": [
        {
            "key": "api_url",
            "label": "API base URL",
            "type": "url",
            "secret": false,
            "required": true
        },
        {
            "key": "client_id",
            "label": "Client ID (ci)",
            "type": "string",
            "secret": false,
            "required": true
        },
        {
            "key": "client_secret",
            "label": "Client secret (cs)",
            "type": "string",
            "secret": true,
            "required": true
        }
    ],
    "docs": "README.md"
}
