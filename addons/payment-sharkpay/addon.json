{
    "id": "payment.sharkpay",
    "name": "SharkPay Payments",
    "version": "1.0.0",
    "description": "SharkPay PIX deposits and payouts (Brazil).",
    "author": "Viper Pro (legacy integration, refactored)",
    "category": "payments",
    "requires": {
        "platform": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Addons\\Payments\\SharkPay\\": "src/"
        }
    },
    "contributes": {
        "payment_gateways": {
            "sharkpay": "Addons\\Payments\\SharkPay\\SharkPayGateway"
        }
    },
    "permissions": [
        "payments.sharkpay.configure",
        "payments.sharkpay.payout"
    ],
    "config": [
        {
            "key": "public_key",
            "label": "Public key",
            "type": "string",
            "secret": false,
            "required": true
        },
        {
            "key": "private_key",
            "label": "Private key",
            "type": "string",
            "secret": true,
            "required": true
        }
    ],
    "docs": "README.md"
}
