{
    "id": "payment.mercadopago",
    "name": "Mercado Pago Payments",
    "version": "1.0.0",
    "description": "Mercado Pago PIX deposits (Brazil).",
    "author": "Viper Pro (legacy integration, refactored)",
    "category": "payments",
    "requires": {
        "platform": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Addons\\Payments\\MercadoPago\\": "src/"
        }
    },
    "contributes": {
        "payment_gateways": {
            "mercadopago": "Addons\\Payments\\MercadoPago\\MercadoPagoGateway"
        }
    },
    "permissions": [
        "payments.mercadopago.configure",
        "payments.mercadopago.payout"
    ],
    "config": [
        {
            "key": "access_token",
            "label": "Access token",
            "type": "string",
            "secret": true,
            "required": true
        }
    ],
    "docs": "README.md"
}
