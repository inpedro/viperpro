{
    "id": "payment.stripe",
    "name": "Stripe Payments",
    "version": "1.0.0",
    "description": "Card and wallet deposits through Stripe Checkout, with signed webhooks and refunds.",
    "author": "Viper Pro",
    "category": "payments",
    "requires": {
        "platform": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Addons\\Payments\\Stripe\\": "src/"
        }
    },
    "contributes": {
        "payment_gateways": {
            "stripe": "Addons\\Payments\\Stripe\\StripeGateway"
        }
    },
    "permissions": [
        "payments.stripe.configure",
        "payments.stripe.refund"
    ],
    "config": [
        {
            "key": "secret_key",
            "label": "Secret key (sk_live_/sk_test_ or restricted rk_)",
            "type": "string",
            "secret": true,
            "required": true
        },
        {
            "key": "publishable_key",
            "label": "Publishable key (pk_...)",
            "type": "string",
            "secret": false,
            "required": false
        },
        {
            "key": "webhook_secret",
            "label": "Webhook signing secret (whsec_...)",
            "type": "string",
            "secret": true,
            "required": true
        }
    ],
    "docs": "README.md"
}
