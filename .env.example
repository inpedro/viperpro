APP_NAME=Laravel
APP_ENV=production
APP_KEY=
# Never enable debug in production: it exposes stack traces, config and secrets.
APP_DEBUG=false
APP_URL=http://localhost
# Storage timezone for timestamps. EXISTING installs upgraded from the original code: America/Sao_Paulo.
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_SECRET=

# --- Security hardening (see docs/SECURITY_AUDIT.md) -------------------------
# Signed game session lifetime in seconds.
GAME_SESSION_TTL=14400

# Payment gateways: credentials are only sent to these HTTPS hosts (comma-separated).
# Confirm each host against the provider's official documentation.
SUITPAY_ALLOWED_HOSTS=ws.suitpay.app
DIGITOPAY_ALLOWED_HOSTS=
MERCADOPAGO_ALLOWED_HOSTS=api.mercadopago.com
SHARKPAY_ALLOWED_HOSTS=sharkpay.com.br
STRIPE_WEBHOOK_SECRET=

# Game provider callbacks are REJECTED until at least one method is configured per provider.
# <P>_CALLBACK_IPS: provider IPs/CIDRs. <P>_CALLBACK_SECRET + <P>_CALLBACK_SECRET_SOURCE
# ("header:X-Name" or "body:field"). Values come from the provider's integration docs.
FIVERS_CALLBACK_IPS=
FIVERS_CALLBACK_SECRET=
FIVERS_CALLBACK_SECRET_SOURCE=
VENIX_CALLBACK_IPS=
VENIX_CALLBACK_SECRET=
VENIX_CALLBACK_SECRET_SOURCE=
PLAYIGAMING_CALLBACK_IPS=
PLAYIGAMING_CALLBACK_SECRET=
PLAYIGAMING_CALLBACK_SECRET_SOURCE=
EVERGAME_CALLBACK_IPS=
EVERGAME_CALLBACK_SECRET=
EVERGAME_CALLBACK_SECRET_SOURCE=
PLAYGAMING_CALLBACK_IPS=
PLAYGAMING_CALLBACK_SECRET=
PLAYGAMING_CALLBACK_SECRET_SOURCE=
SALSA_CALLBACK_IPS=
SALSA_CALLBACK_SECRET=
SALSA_CALLBACK_SECRET_SOURCE=

GOOGLE_FONTS_API_KEY=

# Addons (docs/ADDONS.md). Trusted Ed25519 public keys: "key-id:BASE64,key-id2:BASE64".
ADDONS_TRUSTED_KEYS=
# Also require signatures for addons bundled in this repository (recommended once CI signs releases).
ADDONS_REQUIRE_SIGNATURE_BUNDLED=false

# Multi-tenancy (docs/TENANCY.md)
# Unknown hosts fall back to tenant #1 (single brand). Set false when running several brands.
TENANCY_FALLBACK_DEFAULT=true
# Hosts that serve the super-admin console (/platform), comma-separated.
PLATFORM_DOMAINS=
TENANCY_DEFAULT_CURRENCY=EUR
TENANCY_DEFAULT_CURRENCY_SYMBOL=€
